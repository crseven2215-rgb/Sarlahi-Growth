# Sarlahi Growth Connect - Environment Variables Configuration

# GEMINI_API_KEY: Optional key for Gemini AI API calls and AI Career Advisor.
# Configure this via the Secrets panel in the AI Studio UI.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# Google Sign-In Client ID (for Android & Web OAuth credentials)
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
